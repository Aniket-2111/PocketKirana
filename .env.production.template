# ══════════════════════════════════════════════════════════════════
# PocketKirana — Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
# 1. Store actual production secrets in Cloud Secret Manager / Deployment Vault.
# 2. NEVER commit filled .env files containing production secrets to Git.
# 3. All passwords and keys below are placeholders for production injection.
# ══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ── Application URLs ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pocketkirana.com
NEXT_PUBLIC_API_URL=https://pocketkirana.com/api

# ── Production Managed PostgreSQL 16 (Least-Privilege pk_app_user)
DATABASE_URL=postgresql://pk_app_user:REPLACE_WITH_PRODUCTION_PASSWORD@your-managed-postgres-host.internal:5432/pocketkirana_db?sslmode=require
DATABASE_SSL=true
DB_HOST=your-managed-postgres-host.internal
DB_PORT=5432
DB_NAME=pocketkirana_db
DB_USER=pk_app_user
DB_PASSWORD=REPLACE_WITH_PRODUCTION_PASSWORD

# ── Production Firebase (Client-Side) ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyREPLACE_WITH_PRODUCTION_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pocketkirana-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pocketkirana-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pocketkirana-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_PROD_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:REPLACE_WITH_PROD_APP_ID

# ── FCM Web Push VAPID Key ─────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_VAPID_KEY=REPLACE_WITH_PRODUCTION_VAPID_PUBLIC_KEY

# ── Firebase Admin SDK (Server-Side) ──────────────────────────────
# Single-line minified JSON string from GCP Service Account key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"pocketkirana-prod",...}

# ── PhonePe Business Production Gateway ───────────────────────────
PHONEPE_ENV=production
PHONEPE_MERCHANT_ID=M220000000000000000
PHONEPE_SALT_KEY=REPLACE_WITH_PRODUCTION_SALT_KEY
PHONEPE_SALT_INDEX=1

# ── Razorpay Production Gateway ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_PROD_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_PROD_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_PROD_KEY

# ── MSG91 SMS & OTP Services ──────────────────────────────────────
MSG91_AUTHKEY=REPLACE_WITH_PROD_AUTHKEY
NEXT_PUBLIC_MSG91_WIDGET_ID=REPLACE_WITH_PROD_WIDGET_ID
NEXT_PUBLIC_MSG91_TOKEN_KEY=REPLACE_WITH_PROD_TOKEN_KEY

# ── Security & Authentication Middleware ──────────────────────────
NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=true
NEXTAUTH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_64_CHARS
