# ==========================================
# PocketKirana - Root .gitignore (Hardened)
# ==========================================

# Dependencies (root & all sub-apps)
node_modules/
.pnpm/
.yarn/

# Build & Compiler Outputs (root & all sub-apps)
.next/
out/
build/
dist/
*.tsbuildinfo

# Android Build Outputs & Gradle Cache
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
local.properties
**/android/local.properties
*.hprof

# Transient Android APK/AAB builds (excludes release-apks)
**/build/outputs/apk/
**/build/outputs/aar/
**/build/outputs/bundle/

# Explicitly preserve release APK directory
!release-apks/
!release-apks/**

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.keystore
*.jks
*serviceAccountKey*.json
*credentials*.json

# Firebase & Server Logs
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

.gstack/
