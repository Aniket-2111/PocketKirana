{
  "appId": "com.pocketkirana.picker",
  "appName": "Pocket Kirana Picker",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.msg91.com",
      "control.msg91.com",
      "*.pocketkirana.in",
      "pocketkirana.in",
      "*.pocketkirana.com",
      "pocketkirana.com",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.firebasestorage.app",
      "*.phonepe.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
