{
  "appId": "com.pocketkirana.delivery",
  "appName": "Pocket Kirana Delivery",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.msg91.com",
      "control.msg91.com",
      "*.pocketkirana.in",
      "pocketkirana.in",
      "*.pocketkirana.com",
      "pocketkirana.com",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.firebasestorage.app",
      "*.phonepe.com",
      "*.posthog.com",
      "us.i.posthog.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
