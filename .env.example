# ══════════════════════════════════════════════════════════════════
# PocketKirana — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# .env.local is already in .gitignore.
# ══════════════════════════════════════════════════════════════════

# ── Firebase (Client-Side, NEXT_PUBLIC_ prefix is required) ────────
# Obtain from: Firebase Console → Project Settings → Your Apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Site URL ───────────────────────────────────────────────────────
# Used for OG tags and absolute URL generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://pocketkirana.com

# ── Auth Middleware ────────────────────────────────────────────────
# Set to 'true' to enforce real Firebase auth even on localhost.
# Leave unset (or set to 'false') in .env.local for normal dev workflow —
# the middleware auto-bypasses on localhost so role-switching still works.
# In production (NODE_ENV=production) the middleware ALWAYS enforces auth.
NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=false

# ── Razorpay (Server-Side Only — NO NEXT_PUBLIC_ prefix) ──────────
# Obtain from: Razorpay Dashboard → Settings → API Keys
# Key ID is also needed on the client side for Razorpay checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Secret key MUST stay server-side only (Cloud Functions env)
# Set this in Firebase Functions config, NOT here:
#   firebase functions:config:set razorpay.secret="rzp_secret_xxxxxxxxxx"

# ── PhonePe Configuration (Server-Side Only — NO NEXT_PUBLIC_ prefix)
# Sandbox credentials: https://developer.phonepe.com/v1/reference/test-credentials-uats
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1


# ── Razorpay Configuration (Server-Side Only - NO fallbacks; missing = 503 fail-closed)
# Get keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Explicit simulation flag for local dev (refused in production):
# RAZORPAY_SIMULATION_MODE=true

# ── Auth Middleware (set to true in production to fail closed on invalid tokens)
# NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=true
