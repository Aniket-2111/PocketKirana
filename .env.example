# ══════════════════════════════════════════════════════════════════
# PocketKirana — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# .env.local is already in .gitignore.
# ══════════════════════════════════════════════════════════════════

# ── Firebase (Client-Side, NEXT_PUBLIC_ prefix is required) ────────
# Obtain from: Firebase Console → Project Settings → Your Apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── FCM Web Push VAPID Key (Client-Side) ───────────────────────────
# Obtain from: Firebase Console → Project Settings → Cloud Messaging
# → Web Push certificates → Key pair (the public key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# ── Firebase Admin SDK (Server-Side Only — NO NEXT_PUBLIC_ prefix) ─
# Required for: sending FCM push notifications, verifying ID tokens server-side.
# Option 1 – JSON string (recommended for PaaS/serverless):
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Minify the JSON and paste as a single-line string value below.
# Option 2 – File path (for VMs/containers with the file on disk):
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Site URL ───────────────────────────────────────────────────────
# Used for OG tags and absolute URL generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://pocketkirana.com

# ── Auth Middleware ────────────────────────────────────────────────
# Set to 'true' to enforce real Firebase auth even on localhost.
# Leave unset (or set to 'false') in .env.local for normal dev workflow —
# the middleware auto-bypasses on localhost so role-switching still works.
# In production (NODE_ENV=production) the middleware ALWAYS enforces auth.
NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=false

# ── PostgreSQL Database ────────────────────────────────────────────
# Used for all ACID business data (orders, inventory, products).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pocketkirana_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/pocketkirana_db?schema=public


# ── PhonePe Configuration (Server-Side Only — NO NEXT_PUBLIC_ prefix)
# Sandbox credentials: https://developer.phonepe.com/v1/reference/test-credentials-uats
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# ── Auth Middleware (set to true in production to fail closed on invalid tokens)
# NEXT_PUBLIC_AUTH_MIDDLEWARE_ENABLED=true

# ── MSG91 OTP Widget ─────────────────────────────────────────────
# Obtain from: MSG91 Dashboard → OTP Widget
# Widget ID and Token Key are SAFE for client-side (NEXT_PUBLIC_ prefix).
# AuthKey is SERVER-SIDE ONLY — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_MSG91_WIDGET_ID=your_widget_id_here
NEXT_PUBLIC_MSG91_TOKEN_KEY=your_token_key_here
MSG91_AUTHKEY=your_msg91_authkey_here

# ── Cloudflare R2 Object Storage (Server-Side Only — NO NEXT_PUBLIC_ prefix)
# Obtain from: Cloudflare Dashboard → R2 Object Storage → Manage R2 API Tokens
# R2 credentials must NEVER be prefixed with NEXT_PUBLIC_ or exposed to clients/APKs.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pocketkirana-catalog-images
R2_PUBLIC_DOMAIN=https://images.pocketkirana.com

# ── PostHog Product Analytics ──────────────────────────────────────
# Obtain from: PostHog Project Settings → Project API Key
# NEXT_PUBLIC_POSTHOG_KEY is safe for client-side analytics (Web and APKs)
NEXT_PUBLIC_POSTHOG_KEY=
# E.g. https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side key (falls back to NEXT_PUBLIC_POSTHOG_KEY if unset)
POSTHOG_SERVER_KEY=
POSTHOG_SERVER_HOST=https://us.i.posthog.com

# ── CopilotKit Assistant Lab ──────────────────────────────────────
# Model API key: required for the assistant to answer. Keep server-side.
OPENAI_API_KEY=
COPILOTKIT_MODEL=openai/gpt-4o-mini
# CopilotKit Intelligence project key: enables saved AG-UI threads/streams.
# Obtain it with `npx copilotkit@latest login` then
# `npx copilotkit@latest project select`, or from your Intelligence project.
CPK_INTELLIGENCE_API_KEY=
# Create a Learning container in that Intelligence project to enable learning.
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=
